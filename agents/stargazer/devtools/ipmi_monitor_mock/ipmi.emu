sensor_set_value 0x20 0 6 28 0
sensor_set_event_support 0x20 0 6 enable scanning per-state \
	000111111000000 000111111000000 \
	000111111000000 000111111000000
main_sdr_add 0x20 0x06 0x00 0x51 0x01 0x3a 0x20 0x00 0x06 0x07 0x03 0x7f 0x68 0x0b 0x01 0x80 0x0e 0x80 0x0e 0x3f 0x3f 0x00 0x06 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x10 0x00 0x1c 0x00 0x00 0xff 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xcf 0x70 0x77 0x72 0x5f 0x63 0x6f 0x6e 0x73 0x75 0x6d 0x70 0x74 0x69 0x6f 0x6e

# voltage_12v 12.1 Volts
sensor_add 0x20 0 7 2 0x01
sensor_set_value 0x20 0 7 121 0
sensor_set_event_support 0x20 0 7 enable scanning per-state \
	000111111000000 000111111000000 \
	000111111000000 000111111000000
main_sdr_add 0x20 0x07 0x00 0x51 0x01 0x36 0x20 0x00 0x07 0x07 0x04 0x7f 0x68 0x02 0x01 0x80 0x0e 0x80 0x0e 0x3f 0x3f 0x00 0x04 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0xf0 0x00 0x79 0x00 0x00 0xff 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xcb 0x76 0x6f 0x6c 0x74 0x61 0x67 0x65 0x5f 0x31 0x32 0x76

# voltage_3_3v 3.3 Volts
sensor_add 0x20 0 8 2 0x01
sensor_set_value 0x20 0 8 33 0
sensor_set_event_support 0x20 0 8 enable scanning per-state \
	000111111000000 000111111000000 \
	000111111000000 000111111000000
main_sdr_add 0x20 0x08 0x00 0x51 0x01 0x37 0x20 0x00 0x08 0x07 0x05 0x7f 0x68 0x02 0x01 0x80 0x0e 0x80 0x0e 0x3f 0x3f 0x00 0x04 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0xf0 0x00 0x21 0x00 0x00 0xff 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xcc 0x76 0x6f 0x6c 0x74 0x61 0x67 0x65 0x5f 0x33 0x5f 0x33 0x76

# host_power discrete (ipmi_sensor_status ok=1)
sensor_add 0x20 0 9 34 0x6f
sensor_set_bit_clr_rest 0x20 0 9 0 1
sensor_set_event_support 0x20 0 9 enable scanning per-state \
	000000000000011 000000000000011 \
	000000000000011 000000000000011
main_sdr_add 0x20 0x09 0x00 0x51 0x02 0x20 0x20 0x00 0x09 0x07 0x06 0x63 0x40 0x22 0x6f 0x01 0x00 0x01 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xca 0x68 0x6f 0x73 0x74 0x5f 0x70 0x6f 0x77 0x65 0x72

mc_enable 0x20
