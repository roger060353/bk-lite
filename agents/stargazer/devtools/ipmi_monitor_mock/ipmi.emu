# OpenIPMI ipmi_sim emulator — Hardware Server IPMI monitor mock
# 结构对齐官方 lanserv/ipmisim1.emu：mc_setbmc / mc_add / sensor 0=watchdog / mc_enable。
# 额外补监控插件需要的温度/风扇/功耗/电压 + host_power SDR。

mc_setbmc 0x20
mc_add 0x20 0 no-device-sdrs 0x23 9 8 0x9f 0x1291 0xf02 persist_sdr
sel_enable 0x20 1000 0x0a

# Watchdog sensor. This must be sensor zero.
sensor_add 0x20 0 0 35 0x6f event-only
sensor_set_event_support 0x20 0 0 enable scanning per-state \
	000000000001111 000000000000000 \
	000000000001111 000000000000000

# inlet_temp 22.0 degrees C
sensor_add 0x20 0 1 1 0x01
sensor_set_value 0x20 0 1 22 0
sensor_set_threshold 0x20 0 1 settable 111000 0x2f 0x2f 0x2f 00 00 00
sensor_set_event_support 0x20 0 1 enable scanning per-state \
	000111111000000 000111111000000 \
	000111111000000 000111111000000
main_sdr_add 0x20 0x01 0x00 0x51 0x01 0x35 0x20 0x00 0x01 0x07 0x01 0x7f 0x68 0x01 0x01 0x80 0x0e 0x80 0x0e 0x3f 0x3f 0x00 0x01 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x16 0x00 0x00 0xff 0x00 0x2f 0x2f 0x2f 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xca 0x69 0x6e 0x6c 0x65 0x74 0x5f 0x74 0x65 0x6d 0x70

# cpu1_temp 45.0 degrees C
sensor_add 0x20 0 2 1 0x01
sensor_set_value 0x20 0 2 45 0
sensor_set_threshold 0x20 0 2 settable 111000 0x62 0x62 0x62 00 00 00
sensor_set_event_support 0x20 0 2 enable scanning per-state \
	000111111000000 000111111000000 \
	000111111000000 000111111000000
main_sdr_add 0x20 0x02 0x00 0x51 0x01 0x34 0x20 0x00 0x02 0x03 0x01 0x7f 0x68 0x01 0x01 0x80 0x0e 0x80 0x0e 0x3f 0x3f 0x00 0x01 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x2d 0x00 0x00 0xff 0x00 0x62 0x62 0x62 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xc9 0x63 0x70 0x75 0x31 0x5f 0x74 0x65 0x6d 0x70

# exhaust_temp 33.0 degrees C
sensor_add 0x20 0 3 1 0x01
sensor_set_value 0x20 0 3 33 0
sensor_set_threshold 0x20 0 3 settable 111000 0x50 0x50 0x50 00 00 00
sensor_set_event_support 0x20 0 3 enable scanning per-state \
	000111111000000 000111111000000 \
	000111111000000 000111111000000
main_sdr_add 0x20 0x03 0x00 0x51 0x01 0x37 0x20 0x00 0x03 0x07 0x02 0x7f 0x68 0x01 0x01 0x80 0x0e 0x80 0x0e 0x3f 0x3f 0x00 0x01 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x21 0x00 0x00 0xff 0x00 0x50 0x50 0x50 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xcc 0x65 0x78 0x68 0x61 0x75 0x73 0x74 0x5f 0x74 0x65 0x6d 0x70

# fan1 4200.0 RPM
sensor_add 0x20 0 4 4 0x01
sensor_set_value 0x20 0 4 42 0
sensor_set_event_support 0x20 0 4 enable scanning per-state \
	000111111000000 000111111000000 \
	000111111000000 000111111000000
main_sdr_add 0x20 0x04 0x00 0x51 0x01 0x2f 0x20 0x00 0x04 0x1d 0x01 0x7f 0x68 0x04 0x01 0x80 0x0e 0x80 0x0e 0x3f 0x3f 0x00 0x12 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x20 0x00 0x2a 0x00 0x00 0xff 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xc4 0x66 0x61 0x6e 0x31

# fan2 3900.0 RPM
sensor_add 0x20 0 5 4 0x01
sensor_set_value 0x20 0 5 39 0
sensor_set_event_support 0x20 0 5 enable scanning per-state \
	000111111000000 000111111000000 \
	000111111000000 000111111000000
main_sdr_add 0x20 0x05 0x00 0x51 0x01 0x2f 0x20 0x00 0x05 0x1d 0x02 0x7f 0x68 0x04 0x01 0x80 0x0e 0x80 0x0e 0x3f 0x3f 0x00 0x12 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x20 0x00 0x27 0x00 0x00 0xff 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0xc4 0x66 0x61 0x6e 0x32

# pwr_consumption 280.0 Watts
